# Flask
SECRET_KEY=                    # Random 32-byte hex string
FLASK_ENV=development          # 'development' or 'production'

# Database
DEV_DATABASE_URL=sqlite:///kiraya_haa_dev.db
PROD_DATABASE_URL=mysql+pymysql://user:pass@host/dbname

# Email (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=                 # Gmail address
MAIL_PASSWORD=                 # Gmail App Password (not account password)
MAIL_DEFAULT_SENDER=           # Same as MAIL_USERNAME

# Admin
ADMIN_EMAIL=                   # Admin login email
ADMIN_PASSWORD_HASH=           # bcrypt hash of admin password (generate with provided script)

# Upload
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=26214400    # 25MB in bytes (5 photos x 5MB)
